# Django settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secret-key
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True

# Database settings
{%- if cookiecutter.database_engine == 'postgres' %}
# Uncomment and modify if you want to use PostgreSQL instead of SQLite
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ cookiecutter.project_slug }}
{%- elif cookiecutter.database_engine == 'mysql' %}
# Uncomment and modify if you want to use MySQL instead of SQLite
# DATABASE_URL=mysql://root:password@localhost:3306/{{ cookiecutter.project_slug }}?charset=utf8mb4
{%- endif %}
{%- if cookiecutter.use_redis == "yes" %}

# Redis settings
REDIS_URL=redis://localhost:6379/0
{%- endif %}
{%- if cookiecutter.use_celery == "yes" %}

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
{%- endif %}
