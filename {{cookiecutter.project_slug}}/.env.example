# Django settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secret-key
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True

# Admin security gate (optional)
# Seeds the Constance ADMIN_SECURITY_CODE config; afterwards change it in the admin.
# When empty, /admin/ is directly accessible without unlocking.
# ADMIN_SECURITY_CODE=

# Database settings
{%- if cookiecutter.database_engine == 'postgres' %}
# Uncomment and modify if you want to use PostgreSQL instead of SQLite
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ cookiecutter.project_slug }}
{%- elif cookiecutter.database_engine == 'mysql' %}
# Uncomment and modify if you want to use MySQL instead of SQLite
# DATABASE_URL=mysql://root:password@localhost:3306/{{ cookiecutter.project_slug }}?charset=utf8mb4
{%- endif %}
{%- if cookiecutter.use_redis == "yes" %}

# Redis settings
REDIS_URL=redis://localhost:6379/0
{%- endif %}
{%- if cookiecutter.use_celery == "yes" %}

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/1
{%- if cookiecutter.use_redis == "no" %}
CELERY_RESULT_BACKEND=django-db
{%- endif %}
CELERY_WORKER_CONCURRENCY=10
{%- endif %}

# DJ Control Room (admin ops panels + MCP endpoint for AI agents)
# MCP requests fail until DJ_CONTROL_ROOM_MCP_TOKEN is set.
# Note: with email-based login, MCP user lookup requires dj-control-room to
# resolve users via USERNAME_FIELD (upstream fix pending).
DJ_CONTROL_ROOM_MCP_ENABLED=True
DJ_CONTROL_ROOM_MCP_TOKEN=
DJ_CONTROL_ROOM_MCP_USERNAME=admin
